# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# --- Postgres (Prisma) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/email_scheduler?schema=public"

# --- Redis (BullMQ + rate limiting) ---
REDIS_URL="redis://localhost:6379"

# --- Elasticsearch ---
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_EMAIL_INDEX="emails"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
SESSION_COOKIE_NAME="email_scheduler_session"

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Slack OAuth (https://api.slack.com/apps -> OAuth & Permissions) ---
# Redirect URL: http://localhost:4000/slack/oauth/callback
# Scopes needed: incoming-webhook
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/slack/oauth/callback

# --- Ethereal SMTP (auto-generated if left blank, see README) ---
ETHEREAL_USER=
ETHEREAL_PASS=

# --- Worker / scheduling tuning ---
WORKER_CONCURRENCY=5
# Minimum ms between two sends for the SAME sender (BullMQ Worker limiter)
SENDER_MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100
